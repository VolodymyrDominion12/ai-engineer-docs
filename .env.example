# Змінні середовища для ноутбуків довідника «AI Engineer»
#
# Використання:
#     cp .env.example .env
#     $EDITOR .env          # вписати свої ключі
#
# ВАЖЛИВО: файл .env внесено в .gitignore і НІКОЛИ не потрапляє в git.
# Ніколи не хардкодьте ключі в коді ноутбука — тільки через os.environ.
#
# Усі змінні необов'язкові: кожен ноутбук явно вказує, що йому потрібно,
# у першій markdown-клітинці. Ноутбуки 01, 02, 03, 06, 14 працюють без ключів.

# ─── Anthropic / Claude ──────────────────────────────────────────────────────
# Ноутбуки: 04, 07, 08, 09, 10, 12, 13
# Отримати: https://platform.claude.com/
ANTHROPIC_API_KEY=

# ─── OpenAI ──────────────────────────────────────────────────────────────────
# Ноутбуки: 05
# Отримати: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ─── Hugging Face ────────────────────────────────────────────────────────────
# Ноутбуки: 22 (вивантаження моделей і датасетів, запуск Jobs)
# Потрібен лише для запису. Для читання публічних моделей не потрібен.
# Отримати: https://huggingface.co/settings/tokens
HF_TOKEN=

# ─── Langfuse (спостережуваність) ────────────────────────────────────────────
# Ноутбуки: 23
# Варіант А — хмарний: https://cloud.langfuse.com
# Варіант Б — self-hosted: див. розділ 23, підтема про self-hosting
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Опційно: сумісні провайдери (розділ 5) ──────────────────────────────────
# Будь-який OpenAI-сумісний ендпоінт: локальний сервер, проксі, інший вендор.
# Якщо задано — клієнт OpenAI у ноутбуках 05 і 25 піде сюди замість api.openai.com
OPENAI_BASE_URL=

# ─── Опційно: Postgres для розділу 16 ────────────────────────────────────────
# Потрібні розширення: vector (pgvector) і pg_search для BM25
# docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 pgvector/pgvector:pg17
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ─── Опційно: Qdrant для розділів 15-16 ──────────────────────────────────────
# docker run -p 6333:6333 qdrant/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
